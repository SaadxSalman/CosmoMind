# CosmoMind runtime configuration.
# Copy to .env and edit:  cp .env.example .env

# Operating mode: LOCAL (offline, no keys required) or PROD (cloud backends).
COSMO_MODE=LOCAL

# --- LLM backends (PROD) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Vector store (PROD) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Knowledge graph (PROD) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# --- Local caches (auto-created; safe to commit the dirs if you want) ---
COSMO_DATA_DIR=data
COSMO_VECTOR_CACHE=data/vector_cache
COSMO_KG_CACHE=data/kg_cache

# --- Optional ---
NASA_API_KEY=                  # NASA Exoplanet Archive (unauthenticated access works)
COSMO_ENABLE_CODE_SANDBOX=false  # when true, generated scripts are executed to validate

